CREATE TABLE lesson_progress (
    lesson_id    TEXT NOT NULL PRIMARY KEY,
    completed    INTEGER NOT NULL DEFAULT 0,
    best_correct INTEGER NOT NULL DEFAULT 0,
    last_seen    INTEGER
);

selectAll:
SELECT lesson_id, completed, best_correct FROM lesson_progress;

-- Upsert as insert-or-ignore + update rather than ON CONFLICT DO UPDATE:
-- the latter needs SQLite 3.24+, unavailable on Android API 24–29 and rejected
-- by SQLDelight's default sqlite_3_18 dialect.
insertOrIgnore:
INSERT OR IGNORE INTO lesson_progress(lesson_id, completed, best_correct, last_seen)
VALUES (:lessonId, 0, 0, NULL);

markComplete:
UPDATE lesson_progress SET
    completed = 1,
    best_correct = MAX(best_correct, :correct),
    last_seen = :now
WHERE lesson_id = :lessonId;
