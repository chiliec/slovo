CREATE TABLE user_profile (
    id                 INTEGER NOT NULL PRIMARY KEY,
    goal               TEXT NOT NULL DEFAULT '',
    level              TEXT NOT NULL DEFAULT '',
    daily_goal_minutes INTEGER NOT NULL DEFAULT 15,
    start_unit_id      TEXT NOT NULL DEFAULT '',
    onboarded          INTEGER NOT NULL DEFAULT 0
);

select:
SELECT goal, level, daily_goal_minutes, start_unit_id, onboarded FROM user_profile WHERE id = 0;

initRow:
INSERT OR IGNORE INTO user_profile(id, goal, level, daily_goal_minutes, start_unit_id, onboarded)
VALUES (0, '', '', 15, '', 0);

complete:
UPDATE user_profile SET
    goal = :goal,
    level = :level,
    daily_goal_minutes = :dailyGoalMinutes,
    start_unit_id = :startUnitId,
    onboarded = 1
WHERE id = 0;
