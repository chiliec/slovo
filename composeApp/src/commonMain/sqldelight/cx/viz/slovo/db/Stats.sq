CREATE TABLE user_stats (
    id              INTEGER NOT NULL PRIMARY KEY,
    xp              INTEGER NOT NULL DEFAULT 0,
    streak_days     INTEGER NOT NULL DEFAULT 0,
    last_active_day INTEGER NOT NULL DEFAULT 0,
    streak_freezes  INTEGER NOT NULL DEFAULT 2
);

select:
SELECT xp, streak_days, last_active_day, streak_freezes FROM user_stats WHERE id = 0;

initRow:
INSERT OR IGNORE INTO user_stats(id, xp, streak_days, last_active_day, streak_freezes) VALUES (0, 0, 0, 0, 2);

update:
UPDATE user_stats SET xp = :xp, streak_days = :streak, last_active_day = :day WHERE id = 0;

useFreeze:
UPDATE user_stats SET streak_freezes = streak_freezes - 1, last_active_day = :day WHERE id = 0;

resetStreak:
UPDATE user_stats SET streak_days = 0, last_active_day = :day WHERE id = 0;
