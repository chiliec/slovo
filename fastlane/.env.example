# Template for fastlane/.env (copy to fastlane/.env and fill in — .env is gitignored).
# Loaded automatically by fastlane's dotenv support.
#
#   ASC_KEY_ID     Key ID of the App Store Connect API key. Matches the
#                  AuthKey_<id>.p8 filename in the repo root.
#   ASC_ISSUER_ID  Issuer ID (UUID) — App Store Connect → Users and Access →
#                  Integrations → App Store Connect API → Issuer ID.
#   ASC_APP_ID     Apple's numeric App ID for cx.viz.slovo, from the App Store
#                  Connect app record. Used by scripts/asc_*.rb.

ASC_KEY_ID=948K3FKL2H
ASC_ISSUER_ID=
ASC_APP_ID=
